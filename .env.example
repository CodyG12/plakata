# Copy to .env.local for local overrides. Everything is optional locally:
# without DATABASE_URL the app uses an embedded PGlite database in .data/pglite.

# PostgreSQL connection string. REQUIRED in production (e.g. a Neon pooled URL):
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Signs round tokens and participant cookies, and keys the IP hash.
# REQUIRED in production: at least 32 random characters (openssl rand -hex 32).
# PLAKATA_SECRET=

# Enables GET /api/cron/refresh-rarity (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=

# Prior strength α for rarity snapshots (default 100 equivalent observations).
# RARITY_ALPHA=100

# Max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Turns on the Question Builder at /admin/questions (12+ characters; unset = off).
# ADMIN_PASSWORD=

# Local only: where PGlite stores its data (default .data/pglite).
# PGLITE_DIR=
